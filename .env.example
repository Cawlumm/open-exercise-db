# Copy to .env and fill in for local development (docker-compose reads this file).

# Postgres (local dev via docker-compose; production points at a Supabase session-pooler URI)
POSTGRES_USER=openexercisedb
POSTGRES_PASSWORD=openexercisedb
POSTGRES_DB=openexercisedb
DATABASE_URL=postgres://openexercisedb:openexercisedb@localhost:5432/openexercisedb?sslmode=disable

# Backend
PORT=8080
# Signs session tokens. Blank disables GitHub sign-in (app credentials still work). To enable it,
# generate one: `openssl rand -hex 32`. The server refuses to start with the old published
# placeholder value, and warns on anything shorter than 32 bytes.
JWT_SECRET=

# GitHub OAuth app (Phase 2 — auth)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Comma-separated numeric GitHub user ids (not usernames; look yours up at
# https://api.github.com/users/<login>) who are admins. Authoritative: listed accounts are
# promoted at sign-in and any other admin is demoted to contributor (moderators are kept).
# Leave blank unless you run your own instance; never list someone else's id.
ADMIN_GITHUB_IDS=

# Deprecated: usernames can be renamed and re-registered. Stops promoting anyone on 2027-03-01; logs a warning and is ignored when
# ADMIN_GITHUB_IDS is set.
ADMIN_GITHUB_LOGINS=

# Cloudflare R2 — object storage for images (internal/media.R2Store).
#
# Optional. Leave ALL FOUR blank to use the local filesystem at MEDIA_DIR instead, which is
# the default and needs no cloud account. Setting only some of them is a startup error, not
# a fallback: a production deploy with one mistyped secret name would otherwise boot fine,
# write images to a container's ephemeral disk, and 404 hours later when the instance
# recycles — see internal/media.NewStore.
#
# R2_ACCOUNT_ID is your Cloudflare account ID (the hex string in the R2 S3 endpoint
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com), NOT the "cfat_..." API token value shown
# next to it — those are different credentials and the token will not authenticate here.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY come from R2 > Manage R2 API Tokens (scope the
# token to a single bucket with Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Where the backend re-hosts images when R2 is not configured (internal/media.FilesystemStore).
# Resolved to an absolute path at startup regardless of what's set here, so it no longer
# matters which directory the process is started from — see internal/config's doc comment.
# Ignored by the API server when the four R2_* settings above are present — but NOT by
# cmd/migrate-media, which refuses to run unless R2 is configured and then reads MEDIA_DIR as
# the source directory to copy *from*. The one command that most needs this pointing at the
# right place is the one running with R2 fully set up, so set it before a backfill regardless
# of what the R2 settings say.
#
# Point this somewhere persistent. Postgres keeps exercise_images rows on its own volume, so
# a MEDIA_DIR on ephemeral storage (a container's writable layer, a tmpfs) leaves the database
# advertising images whose bytes are gone — every URL a 404. docker-compose.yml mounts
# ./data/media for this reason. Re-running cmd/import-freeexercisedb repairs that state and
# warns when it has to.
# MEDIA_DIR=./data/media

# External host contract.Exercise.Images[].url should point at instead of this API's own
# GET /api/v1/images/{id} route — an R2 public bucket or a CDN in front of it (mirrors Open
# Food Facts' separate images.openfoodfacts.org host). Use a custom domain, not the managed
# *.r2.dev subdomain: Cloudflare rate-limits r2.dev and documents it as development-only.
#
# Leave unset for local dev and self-host: images are served through media.Store instead,
# same bytes either way, at the cost of proxying every image byte through this process.
# The server logs a warning when this and the storage backend disagree — see
# internal/config.Config.Warnings.
# IMAGE_BASE_URL=

# Which proxy may be believed about the client address for rate limiting:
# cloudrun (right-most X-Forwarded-For; the default when K_SERVICE is set), cloudflare
# (CF-Connecting-IP; only when Cloudflare is the sole path to the origin) or direct (the TCP
# peer; the default elsewhere). See docs/DEPLOYMENT.md.
# TRUSTED_PROXY_MODE=

# Rate limiting (docs/API_POLICY.md) — origin-level per-instance backstop, tiered by cost.
# All optional; unset falls back to the defaults documented in
# backend/internal/config/config.go (RateLimitConfig). Override on a staging/CI instance to
# avoid self-DoSing it with production-sized bursts, or lower further for load testing.
# OEDB_RATELIMIT_READ_RPM=60
# OEDB_RATELIMIT_READ_BURST=20
# OEDB_RATELIMIT_SEARCH_RPM=60
# OEDB_RATELIMIT_SEARCH_BURST=20
# OEDB_RATELIMIT_EXPORT_RPM=5
# OEDB_RATELIMIT_EXPORT_BURST=2
# OEDB_RATELIMIT_UNIDENTIFIED_RPM=5
# OEDB_RATELIMIT_UNIDENTIFIED_BURST=2
