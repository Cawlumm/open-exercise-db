# Copy to .env and fill in for local development (docker-compose reads this file).

# Postgres (local dev via docker-compose; production points at a Neon connection string)
POSTGRES_USER=openexercisedb
POSTGRES_PASSWORD=openexercisedb
POSTGRES_DB=openexercisedb
DATABASE_URL=postgres://openexercisedb:openexercisedb@localhost:5432/openexercisedb?sslmode=disable

# Backend
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string

# GitHub OAuth app (Phase 2 — auth)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Comma-separated GitHub usernames auto-promoted to admin on first login
ADMIN_GITHUB_LOGINS=Cawlumm

# Cloudflare R2 (image/video storage — Phase 2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Rate limiting (docs/API_POLICY.md) — origin-level per-instance backstop, tiered by cost.
# All optional; unset falls back to the defaults documented in
# backend/internal/config/config.go (RateLimitConfig). Override on a staging/CI instance to
# avoid self-DoSing it with production-sized bursts, or lower further for load testing.
# OEDB_RATELIMIT_READ_RPM=60
# OEDB_RATELIMIT_READ_BURST=20
# OEDB_RATELIMIT_SEARCH_RPM=30
# OEDB_RATELIMIT_SEARCH_BURST=15
# OEDB_RATELIMIT_EXPORT_RPM=5
# OEDB_RATELIMIT_EXPORT_BURST=2
# OEDB_RATELIMIT_UNIDENTIFIED_RPM=5
# OEDB_RATELIMIT_UNIDENTIFIED_BURST=2
